{
  "name": "analytical-platform-cloud-development-environment-base",
  "image": "ghcr.io/ministryofjustice/devcontainer-base:latest",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {},
    "ghcr.io/ministryofjustice/devcontainer-feature/apm:1.0.0": {},
    "ghcr.io/devcontainers/features/github-cli:": {},
    "ghcr.io/ministryofjustice/devcontainer-feature/container-structure-test:1.0.1": {},
    "ghcr.io/ministryofjustice/devcontainer-feature/static-analysis:2.0.0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "GitHub.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "GitHub.copilot-chat",
        "GitHub.copilot"
      ]
    }
  },
  "postCreateCommand": "/bin/bash .devcontainer/post-create.sh"
}
